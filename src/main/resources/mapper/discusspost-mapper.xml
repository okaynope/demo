<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.demo.dao.DiscussPostMapper">
    <sql id="selectFields">
        id,user_id,title,content,discuss_post_type,discuss_post_status,create_time,comment_count,score
    </sql>
    <sql id="insertFields">
        user_id,title,content,discuss_post_type,discuss_post_status,create_time,comment_count,score
    </sql>

    <select id="selectDiscussPosts" resultType="DiscussPost">
        select <include refid="selectFields"></include>
        from discuss_post
        where discuss_post_status != 2
        <if test="userId!=0">
            and user_id = #{userId}
        </if>
        <if test="orderMode==0">
            order by discuss_post_type desc, create_time desc
        </if>
        <if test="orderMode==1">
            order by discuss_post_type desc, score desc, create_time desc
        </if>
        limit #{offset}, #{limit}
    </select>

    <select id="selectDiscussPostRows" resultType="int">
        select count(id)
        from `discuss_post`
        where discuss_post_status != 2
        <if test="userId!=0">
            and `user_id` = #{userId}
        </if>
    </select>

    <insert id="insertDiscussPost" keyProperty="id" parameterType="DiscussPost">
        insert into discuss_post(<include refid="insertFields"></include>)
        values(#{userId}, #{title}, #{content}, #{discussPostType}, #{discussPostStatus}, #{createTime}, #{commentCount}, #{score})
    </insert>

    <select id="selectDiscussPostById" resultType="DiscussPost">
        select <include refid="selectFields"></include>
        from discuss_post
        where id = #{id}
    </select>

    <update id="updateDiscussCommentCount">
        update discuss_post
        set comment_count = #{commentCount}
        where id = #{id}
    </update>

    <update id="updateType">
        update discuss_post
        set discuss_post_type = #{discussPostType}
        where id = #{id}
    </update>

    <update id="updateStatus">
        update discuss_post
        set discuss_post_status = #{discussPostStatus}
        where id = #{id}
    </update>

    <update id="updateScore">
        update discuss_post
        set score = #{score}
        where id = #{id}
    </update>
</mapper>