<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.demo.dao.DiscussCommentMapper">
    <sql id="selectFields">
        id,user_id,entity_type,entity_id,target_id,content,comment_status,create_time
    </sql>
    <sql id="insertFields">
        user_id,entity_type,entity_id,target_id,content,comment_status,create_time
    </sql>

    <select id="selectDiscussCommentsByEntity" resultType="DiscussComment">
        select <include refid="selectFields"></include>
        from discuss_comment
        where comment_status = 0
        and entity_type = #{entityType}
        and entity_id = #{entityId}
        order by create_time desc
        limit #{offset}, #{limit}
    </select>

    <select id="selectDiscussCommentByEntity" resultType="int">
        select count(id)
        from discuss_comment
        where comment_status = 0
        and entity_type = #{entityType}
        and entity_id = #{entityId}
    </select>

    <select id="selectDiscussCommentByUserId" resultType="int">
        select count(id)
        from discuss_comment
        where comment_status = 0
        and user_id = #{userId}
    </select>

    <select id="selectDiscussCommentByUserIds" resultType="DiscussComment">
        select <include refid="selectFields"></include>
        from discuss_comment
        where comment_status = 0
        and user_id = #{userId}
        order by create_time desc
        limit #{offset}, #{limit}
    </select>

    <select id="selectDiscussCommentById" resultType="DiscussComment">
        select <include refid="selectFields"></include>
        from discuss_comment
        where id = #{id}
    </select>

    <insert id="insertDiscussComment" keyProperty="id" parameterType="DiscussComment">
        insert into discuss_comment(<include refid="insertFields"></include>)
        values(#{userId}, #{entityType}, #{entityId}, #{targetId}, #{content}, #{commentStatus}, #{createTime})
    </insert>
</mapper>